# Reference only: export in shell or deployment secret manager.
# Never place secrets in VITE_* variables.
SPRING_PROFILES_ACTIVE=dev
# Production JDBC: jdbc:postgresql://<endpoint>.neon.tech/<database>
# No query parameters or embedded credentials; TLS is configured separately.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
DB_SSL_MODE=verify-full
# HTTPS origins, no trailing slash/path. Leave optional CORS variable UNSET to use FRONTEND_URL.
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=
JWT_SECRET=
# Milliseconds; production accepts at most 60 minutes. Generate a random secret.
JWT_EXPIRATION=3600000
# Dev ignores DB_* to avoid inherited production credentials.
DEV_DB_URL=jdbc:postgresql://localhost:5432/emr_financas
DEV_DB_USERNAME=
DEV_DB_PASSWORD=
DEV_DB_SSL_MODE=disable
DEV_SEED_USER_ENABLED=false
DEV_SEED_USER_NAME=
DEV_SEED_USER_EMAIL=
DEV_SEED_USER_PASSWORD=
# Provider-neutral SMTP; authenticated STARTTLS is mandatory in prod.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=
PASSWORD_RESET_EXPIRATION_MINUTES=15
# Build-time: /api for same origin; https://<api-domain>/api for separate origins.
VITE_API_BASE_URL=/api
