# Backend (DB_URL must be a JDBC URL, including sslmode=require for Neon)
DB_URL=
DB_USERNAME=
DB_PASSWORD=
DB_SSL_MODE=require
FRONTEND_URL=http://localhost:5173
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=
JWT_EXPIRATION=3600000

# Optional development-only seed. Keep disabled unless all three values are set.
DEV_SEED_USER_ENABLED=false
DEV_SEED_USER_NAME=
DEV_SEED_USER_EMAIL=
DEV_SEED_USER_PASSWORD=

# Mail & Password Reset (SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=noreply@emrfinancas.com.br
PASSWORD_RESET_EXPIRATION_MINUTES=15

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
VITE_USE_MOCK_API=false
